.include /foss/designs/final_project/AFE/layout/lvs/dbs_afe_top.spice"}
C {devices/code_shown.sym} -350 400 0 0 {name=STIM only_toplevel=false value=".include stim.inc
Cdout dout 0 15p
Ripg0 ipg0 ref 1g
Ripg1 ipg1 ref 1g
Ripg2 ipg2 ref 1g
Ripg3 ipg3 ref 1g
Rrec0 rec0 0 1e13
Rrec1 rec1 0 1e13
Rrec2 rec2 0 1e13
Rrec3 rec3 0 1e13
Rfl_dout_in dout_in 0 1g
Rfl_dout_oe dout_oe 0 1g
Rfl_dout_ie dout_ie 0 1g
Rfl_dout_pd dout_pd 0 1g
Rfl_dout_pu dout_pu 0 1g
Rfl_dout_cs dout_cs 0 1g
Rfl_dout_sl dout_sl 0 1g
Rfl_dout_pdrv0 dout_pdrv0 0 1g
Rfl_dout_pdrv1 dout_pdrv1 0 1g
Rfl_cs_pu cs_pu 0 1g
Rfl_cs_pd cs_pd 0 1g
Rfl_din_pu din_pu 0 1g
Rfl_din_pd din_pd 0 1g
Rfl_sclk_pu sclk_pu 0 1g
Rfl_sclk_pd sclk_pd 0 1g
Rfl_rstn_pu rstn_pu 0 1g
Rfl_rstn_pd rstn_pd 0 1g"}
C {devices/code_shown.sym} 0 400 0 0 {name=SIM only_toplevel=false value=".options abstol=1e-12 reltol=1e-3 method=gear
.temp 27
.tran 50n 0.03 0 200n
.control
set num_threads=1
set wr_singlescale
set wr_vecnames
run
wrdata tb_out.txt v(cs) v(sclk) v(din) v(dout) v(e0) v(e1) v(vdd)
.endc"}
T {Sources E0-E3, REF, SPI pins and the electrode PWL are in stim.inc (included below). Check with decode_dout.py after the run.} -700 300 0 0 0.3 0.3 {}
