let vdsat_xch_xs2_xota2_xms = abs(@m.xch.xs2.xota2.xms.m0[vdsat])
let vgs_xch_xs2_xota2_xms = abs(@m.xch.xs2.xota2.xms.m0[vgs])
let mg_xch_xs2_xota2_xms = vds_xch_xs2_xota2_xms - vdsat_xch_xs2_xota2_xms
let gmid_xch_xs2_xota2_xms = @m.xch.xs2.xota2.xms.m0[gm]/id_xch_xs2_xota2_xms
echo OPDEV xch.xs2.xota2.xms id_A=$&id_xch_xs2_xota2_xms vgs_V=$&vgs_xch_xs2_xota2_xms vds_V=$&vds_xch_xs2_xota2_xms vdsat_V=$&vdsat_xch_xs2_xota2_xms margin_V=$&mg_xch_xs2_xota2_xms gm_over_id=$&gmid_xch_xs2_xota2_xms
let vo = v(out)
let itot = -i(Vdd)
let ibia = abs(@m.xch.xsink1.m0[id])
let verr = v(out) - v(vcmo)
echo OPSUM vout_V=$&vo vout_err_V=$&verr vbn_V=$&v(vbn) vcm_V=$&v(vcm) vg1_V=$&v(vg1) vcmo_V=$&v(vcmo) vg2_V=$&v(vg2) i_supply_A=$&itot ibias1_A=$&ibia
echo OPNODE v1_V=$&v(xch.v1) vn1_V=$&v(xch.xs1.vn) vp1_V=$&v(xch.xs1.vp) vn2_V=$&v(xch.xs2.vn2) o2_V=$&v(xch.xs2.xota2.o2)
quit
.endc
.end
