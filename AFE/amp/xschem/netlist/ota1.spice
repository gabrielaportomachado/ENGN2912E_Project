Xmb ibias ibias vdd vdd pfet_03v3 L='OTA_LT' W='OTA_WT' nf=1 ad='DIFF*OTA_WT*0.18u' as='DIFF*OTA_WT*0.18u' pd='DIFF*2*(OTA_WT+0.18u)'
+ ps='DIFF*2*(OTA_WT+0.18u)' nrd=0 nrs=0 sa=0 sb=0 sd=0 m='OTA_KB'
