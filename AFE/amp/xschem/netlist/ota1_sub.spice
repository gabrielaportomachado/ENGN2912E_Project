Xmb ibias ibias vdd vdd pfet_03v3 L='OTA_LT' W='OTA_WT' nf=1 ad=0 as=0 pd=0 ps=0 nrd=0 nrs=0 sa=0 sb=0 sd=0 m='OTA_KB'
